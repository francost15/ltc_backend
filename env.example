# Configuración de OpenAI (REQUERIDO para matching)
OPENAI_API_KEY=tu-api-key-de-openai-aqui

# Configuración de la aplicación
SECRET_KEY=tu-clave-secreta-super-segura-ltc-2024
FLASK_DEBUG=True

# Base de datos (opcional, usa valores por defecto de Docker Compose)
DATABASE_URL=postgresql://ltc_user:ltc_password_2024@postgres:5432/ltc_db

# Configuración de archivos
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Configuración de CORS
CORS_ORIGINS=*

